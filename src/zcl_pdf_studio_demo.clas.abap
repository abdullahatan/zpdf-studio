"! <p>ZPDF Studio demo: invoice form ZPDF_STUDIO_INVOICE and typed demo data.</p>
"! Generated by designer/scripts/generate-demo.ts from designer/src/sample-template.ts - do not edit.
"! The form shows: Turkish texts, master page footer with page numbers, a conditional watermark,
"! date / number formats, amount in words, a table that breaks across pages, DataMatrix, EAN-13, QR.
CLASS zcl_pdf_studio_demo DEFINITION
  PUBLIC
  FINAL
  CREATE PRIVATE.

  PUBLIC SECTION.
    CONSTANTS c_form TYPE string VALUE 'ZPDF_STUDIO_INVOICE'.

    TYPES:
      BEGIN OF ty_kalem,
        matnr TYPE c LENGTH 18,
        maktx TYPE string,
        menge TYPE p LENGTH 13 DECIMALS 3,
        netpr TYPE p LENGTH 13 DECIMALS 2,
        netwr TYPE p LENGTH 13 DECIMALS 2,
      END OF ty_kalem,
      ty_kalemler TYPE STANDARD TABLE OF ty_kalem WITH EMPTY KEY,
      BEGIN OF ty_fatura,
        fatura_no      TYPE string,
        fatura_tarihi  TYPE d,
        vade           TYPE d,
        musteri_adi    TYPE string,
        musteri_adres  TYPE string,
        vergi_no       TYPE string,
        toplam         TYPE p LENGTH 15 DECIMALS 2,
        para_birimi    TYPE c LENGTH 5,
        fatura_no_kare TYPE string,
        gtin           TYPE string,
        taslak         TYPE abap_bool,
        aciklama       TYPE string,
        kalemler       TYPE ty_kalemler,
      END OF ty_fatura.

    "! Form as stored by the designer (HTML, page, sample data).
    CLASS-METHODS template
      RETURNING
        VALUE(rs_template) TYPE zcl_pdf_studio_repo=>ty_template.

    "! Creates form ZPDF_STUDIO_INVOICE when it does not exist (or always with iv_force).
    CLASS-METHODS install
      IMPORTING
        iv_force TYPE abap_bool DEFAULT abap_false
      RAISING
        zcx_pdf_studio.

    "! Demo invoice with iv_rows items.
    CLASS-METHODS invoice
      IMPORTING
        iv_rows           TYPE i DEFAULT 12
        iv_draft          TYPE abap_bool DEFAULT abap_false
      RETURNING
        VALUE(rs_invoice) TYPE ty_fatura.
ENDCLASS.



