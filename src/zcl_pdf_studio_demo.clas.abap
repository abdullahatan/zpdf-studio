  METHOD install.
    DATA lv_exists TYPE abap_bool VALUE abap_true.
    TRY.
        zcl_pdf_studio_repo=>read_form( c_form ).
      CATCH zcx_pdf_studio.
        lv_exists = abap_false.
    ENDTRY.
    IF lv_exists = abap_true AND iv_force = abap_false.
      RETURN.
    ENDIF.
    IF lv_exists = abap_false.
      zcl_pdf_studio_repo=>create_form(
        iv_form_id     = c_form
        iv_description = 'ZPDF Studio demo invoice' ).
    ENDIF.
    zcl_pdf_studio_repo=>save_template( is_template = template( ) iv_new_version = abap_true ).
    zcl_pdf_studio_repo=>commit_changes( ).
  ENDMETHOD.


  METHOD invoice.
    DATA ls_item TYPE ty_kalem.
    DATA lv_i TYPE i.
    DATA lt_names TYPE STANDARD TABLE OF string WITH EMPTY KEY.
    DATA lv_name TYPE string.

    lt_names = VALUE #( ( `Vida 4×40 (çinko kaplı)` ) ( `Somun M4 – paslanmaz` ) ( `Pul Ø8 galvaniz` )
                        ( `Dübel 8 mm` ) ( `Çelik halat 6 mm (metre)` ) ( `Şerit metre 5 m` ) ).
    rs_invoice-fatura_no = |FT-{ sy-datum(4) }-0001|.
    rs_invoice-fatura_tarihi = sy-datum.
    rs_invoice-vade = sy-datum + 30.
    rs_invoice-musteri_adi = `Yıldız Gıda San. ve Tic. A.Ş.`.
    rs_invoice-musteri_adres = `Organize Sanayi Bölgesi 3. Cad. No:14, Melikgazi / Kayseri`.
    rs_invoice-vergi_no = `9876543210`.
    rs_invoice-para_birimi = 'TRY'.
    rs_invoice-gtin = `869012345678`.
    rs_invoice-taslak = iv_draft.
    rs_invoice-aciklama = `Ödeme vadesinde banka havalesi ile yapılacaktır.`.
    DO iv_rows TIMES.
      lv_i = sy-index.
      CLEAR ls_item.
      READ TABLE lt_names INTO lv_name INDEX ( lv_i - 1 ) MOD lines( lt_names ) + 1.
      ls_item-matnr = |M-{ 100 + lv_i }|.
      ls_item-maktx = lv_name.
      ls_item-menge = 10 + lv_i * 7.
      ls_item-netpr = '1.5' + lv_i / 4.
      ls_item-netwr = ls_item-menge * ls_item-netpr.
      rs_invoice-toplam = rs_invoice-toplam + ls_item-netwr.
      APPEND ls_item TO rs_invoice-kalemler.
    ENDDO.
    rs_invoice-fatura_no_kare = |{ rs_invoice-fatura_no };{ rs_invoice-toplam };{ rs_invoice-vergi_no }|.
  ENDMETHOD.

ENDCLASS.
